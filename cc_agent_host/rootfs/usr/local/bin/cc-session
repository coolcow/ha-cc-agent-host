#!/bin/bash
# Command of the persistent tmux session "cc" (web terminal): Claude Code, then a shell.
# When the shell exits, the session ends and the session service starts a new one.

cd /homeassistant || cd /

if [ ! -s "$CLAUDE_CONFIG_DIR/.credentials.json" ]; then
    echo "Not signed in yet: type /login in Claude Code and follow the steps."
    echo "Remote Control, if enabled, starts by itself once you are signed in."
    echo
fi

claude --settings /usr/share/cc_agent_host/interactive-settings.json

echo
echo "Claude Code has exited. This is a shell; type 'exit' to start Claude Code again."
exec bash -l
