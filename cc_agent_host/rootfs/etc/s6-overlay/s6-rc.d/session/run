#!/usr/bin/with-contenv bashio
# Keeps the tmux session "cc" (web terminal) alive, also without a browser attached
while true; do
    if ! tmux has-session -t cc 2>/dev/null; then
        bashio::log.info "Starting session"
        tmux new-session -d -s cc -x 200 -y 50 /usr/local/bin/cc-session
    fi
    sleep 5
done
