          "host": "Host",
          "port": "Port",
          "api_key": "API key"
        },
        "description": "Address and API key of the CC Agent Host job API."
      },
      "reauth_confirm": {
        "data": {
          "api_key": "API key"
        },
        "description": "The API key of the add-on is no longer valid."
      }
    },
    "error": {
      "cannot_connect": "The add-on is not reachable.",
